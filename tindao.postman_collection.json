    {
      "name": "Events",
      "item": [
        {
          "name": "Create Main Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('eventId', res.data.id);",
                  "  pm.collectionVariables.set('inviteCode', res.data.inviteCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/events",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Balada do Mês\",\n  \"description\": \"A maior festa universitária do semestre, com DJs nacionais e open bar.\",\n  \"category\": \"NIGHTLIFE\",\n  \"city\": \"São Paulo\",\n  \"venueName\": \"Clube X\",\n  \"address\": \"Rua das Flores, 123\",\n  \"latitude\": -23.5505,\n  \"longitude\": -46.6333,\n  \"startAt\": \"2026-06-15T22:00:00.000Z\",\n  \"endAt\": \"2026-06-16T06:00:00.000Z\",\n  \"prePartyPermissionMode\": \"ORGANIZER_ONLY\",\n  \"afterPartyPermissionMode\": \"ATTENDEES_ALLOWED\"\n}"
            }
          }
        },
        {
          "name": "List Events",
